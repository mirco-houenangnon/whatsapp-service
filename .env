# ─── WhatsApp Bridge Service ──────────────────────────────────────────────────
# Port d'écoute (doit correspondre à WHATSAPP_BRIDGE_URL dans backend-modules/.env)
PORT=3005

# ─── Environnement ────────────────────────────────────────────────────────────
# local | production
NODE_ENV=local

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origine(s) autorisées à se connecter via Socket.io (séparées par virgule)
# En local : * (tout)   | En production : https://votre-domaine.com
CORS_ORIGIN=*

# ─── Notes ────────────────────────────────────────────────────────────────────
# Ce service utilise Baileys LOCAL (../Baileys) — pas le paquet npm.
# Avant le premier démarrage : npm run setup
# Pour démarrer : npm run dev (développement) ou npm start (production)
# Le backend Laravel pointe sur ce service via WHATSAPP_BRIDGE_URL=http://127.0.0.1:3005
