# ─── WhatsApp Bridge Service — Environnement LOCAL ───────────────────────────
# Ce fichier est dans .gitignore — NE JAMAIS commiter

# Port d'écoute
PORT=3005

# Environnement
NODE_ENV=local

# Clé API partagée avec le backend
# En local, laisser vide = pas de protection (pratique pour le développement)
# En production, générer avec : openssl rand -hex 32
BRIDGE_API_KEY=

# Origines CORS autorisées
# local : *   |   production : https://votre-domaine.com
CORS_ORIGIN=*

# Activer le dashboard HTML (public/index.html)
# En local : true   |   En production : false (sauf si protégé par nginx)
ENABLE_DASHBOARD=true
